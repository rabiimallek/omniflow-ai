# ==============================================================================
# OmniFlow AI - Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific credentials.
# DO NOT commit real secrets or the '.env' file to version control.
# ==============================================================================

# --- Service Ports ---
N8N_PORT=5678
GOTENBERG_PORT=3000

# --- n8n Service Settings ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
# Optional encryption key for n8n credentials storage (generated automatically if omitted)
# N8N_ENCRYPTION_KEY=your_generated_encryption_key_here

# --- PostgreSQL Database (Local or Containerized) ---
# Note: For n8n running in Docker on Windows/macOS to connect to local PostgreSQL,
# use 'host.docker.internal' as POSTGRES_HOST.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSL=disable

# --- LLM API Credentials (Configured inside n8n UI) ---
# 1. Primary Model: Google Gemini API (PaLM / Gemini API key)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash

# 2. Fallback Model: OpenAI API Key (Optional fallback if Gemini errors out)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Storage & Reporting Defaults ---
REPORT_STORAGE_PATH=./reports
DEFAULT_REPORTING_MONTH=2026-10
DEFAULT_COMPANY_NAME="Northstar Business Services"
DEFAULT_CURRENCY=TND
